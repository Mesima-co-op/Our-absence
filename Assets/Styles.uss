.ManuOptionsButtonStyle {
    flex-grow: 0;
    flex-shrink: 1;
    align-items: center;
    width: 90%;
    flex-direction: row;
    justify-content: flex-start;
    -unity-text-align: middle-right;
    height: 15%;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    white-space: nowrap;
    flex-wrap: nowrap;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-text-outline-width: 1px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    font-size: 18px;
    background-image: url("project://database/Assets/Resources/Sprites&images/Hub/Button-005.png?fileID=2800000&guid=804eb61f3f003b845b954cd570c207d9&type=3#Button-005");
    opacity: 1;
}

.ManuOptionsButtonStyle:hover {
    flex-grow: 0;
    flex-shrink: 1;
    align-items: center;
    width: 90%;
    flex-direction: row;
    justify-content: flex-start;
    -unity-text-align: middle-right;
    height: 15%;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    white-space: nowrap;
    flex-wrap: nowrap;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    font-size: 18px;
    opacity: 1;
    scale: 1 1;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    background-color: rgba(101, 46, 11, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-image: resource('Sprites&images/Hub/Button-006');
}

.ManuOptionsButtonStyle:active {
    flex-grow: 0;
    flex-shrink: 1;
    align-items: center;
    width: 90%;
    flex-direction: row;
    justify-content: flex-start;
    -unity-text-align: middle-right;
    height: 15%;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    white-space: nowrap;
    flex-wrap: nowrap;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold-and-italic;
    font-size: 20px;
    scale: 0.9 0.9;
}

.EquipmentSlotStyle {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    width: 40%;
    flex-direction: row;
    justify-content: center;
    -unity-text-align: middle-right;
    height: 20%;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    white-space: nowrap;
    flex-wrap: nowrap;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-text-outline-width: 0;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    font-size: 18px;
    background-image: url("project://database/Assets/Resources/Sprites&images/Hub/item_frame-001.png?fileID=2800000&guid=5451721a11a53a8499255430d0d63734&type=3#item_frame-001");
    scale: 1 1;
    align-self: center;
    overflow: hidden;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}

