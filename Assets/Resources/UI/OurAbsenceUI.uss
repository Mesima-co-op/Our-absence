/* Shared look for the start menu and the loading screen.
   Built from the existing UI art: Hub backgrounds, paper buttons and the WashingtonText font. */

.oa-root {
    flex-grow: 1;
    -unity-font-definition: initial;
    -unity-font: resource('Fonts/WashingtonText');
    color: rgb(196, 190, 176);
}

.oa-backdrop {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: resource('Sprites&images/Hub/background_menu_AI_001');
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(150, 150, 150, 1);
}

.oa-shade {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
}

/* ── Title ─────────────────────────────────────────────── */

.oa-title-block {
    position: absolute;
    left: 7%; top: 12%;
}

.oa-title {
    font-size: 76px;
    letter-spacing: 6px;
    color: rgb(222, 214, 196);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    margin: 0;
    padding: 0;
}

.oa-subtitle {
    font-size: 20px;
    color: rgb(150, 140, 120);
    margin-top: 6px;
    -unity-font-style: italic;
}

/* ── Main menu buttons ─────────────────────────────────── */

.oa-menu {
    position: absolute;
    left: 7%; bottom: 14%;
    width: 340px;
}

.oa-button {
    height: 52px;
    margin: 6px 0;
    padding: 0 18px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource('Sprites&images/Hub/Button-005');
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(150, 140, 122);
    -unity-font-definition: initial;
    -unity-font: resource('Fonts/WashingtonText');
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    font-size: 24px;
    color: rgb(206, 196, 176);
    transition-property: -unity-background-image-tint-color, translate, color;
    transition-duration: 0.15s;
}

.oa-button:hover,
.oa-button:focus {
    background-image: resource('Sprites&images/Hub/Button-006');
    -unity-background-image-tint-color: rgb(196, 176, 160);
    color: rgb(18, 12, 8);
    translate: 8px 0;
}

.oa-button:active {
    -unity-background-image-tint-color: rgb(255, 220, 190);
}

.oa-button:disabled {
    -unity-background-image-tint-color: rgb(70, 66, 60);
    color: rgb(80, 74, 66);
    translate: 0 0;
}

.oa-button__detail {
    position: absolute;
    right: 16px;
    top: 0; bottom: 0;
    -unity-text-align: middle-right;
    font-size: 15px;
    -unity-font-style: normal;
    color: rgb(140, 130, 112);
}

.oa-button:hover > .oa-button__detail,
.oa-button:focus > .oa-button__detail {
    color: rgb(40, 28, 18);
}

.oa-version {
    position: absolute;
    right: 18px; bottom: 12px;
    font-size: 13px;
    color: rgb(110, 104, 92);
}

/* ── Panels (save slots, confirm) ──────────────────────── */

.oa-panel {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.oa-panel__frame {
    width: 620px;
    padding: 36px 40px;
    background-image: resource('Sprites&images/Hub/background-003');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(8, 8, 8, 0.92);
}

.oa-panel__title {
    font-size: 34px;
    color: rgb(222, 214, 196);
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.oa-slot {
    height: 86px;
    margin: 6px 0;
    padding: 10px 18px;
    border-width: 1px;
    border-color: rgba(150, 140, 120, 0.35);
    border-radius: 0;
    background-color: rgba(30, 28, 25, 0.85);
    flex-direction: row;
    align-items: center;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.oa-slot:hover,
.oa-slot:focus {
    background-color: rgba(70, 58, 40, 0.9);
    border-color: rgba(230, 190, 120, 0.8);
}

.oa-slot:disabled {
    opacity: 0.45;
}

.oa-slot__text {
    flex-grow: 1;
}

.oa-slot__name {
    font-size: 22px;
    color: rgb(222, 214, 196);
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.oa-slot__info {
    font-size: 15px;
    color: rgb(150, 140, 120);
    -unity-text-align: middle-left;
    margin: 4px 0 0 0;
    padding: 0;
}

.oa-slot__delete {
    width: 84px;
    height: 34px;
    font-size: 15px;
    border-width: 1px;
    border-radius: 0;
    border-color: rgba(170, 70, 60, 0.6);
    background-color: rgba(60, 18, 14, 0.7);
    color: rgb(220, 160, 150);
    -unity-font-definition: initial;
    -unity-font: resource('Fonts/WashingtonText');
}

.oa-slot__delete:hover {
    background-color: rgba(120, 30, 24, 0.9);
}

.oa-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 18px;
}

.oa-row > .oa-button {
    width: 200px;
    margin: 0 8px;
    -unity-text-align: middle-center;
}

.oa-confirm__text {
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(200, 190, 170);
}

.oa-hidden {
    display: none;
}

/* ── Loading screen ────────────────────────────────────── */

.oa-loading {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(4, 4, 5);
    justify-content: center;
    align-items: center;
}

.oa-loading .oa-backdrop {
    -unity-background-image-tint-color: rgba(70, 70, 70, 1);
}

.oa-ember {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(255, 150, 60);
    margin-bottom: 28px;
}

.oa-loading__lore {
    max-width: 62%;
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-font-style: italic;
    color: rgb(190, 180, 160);
}

.oa-loading__bottom {
    position: absolute;
    left: 7%; right: 7%; bottom: 8%;
}

.oa-loading__area {
    font-size: 30px;
    color: rgb(222, 214, 196);
    margin-bottom: 10px;
}

.oa-bar {
    height: 4px;
    background-color: rgba(255, 255, 255, 0.08);
}

.oa-bar__fill {
    height: 100%;
    width: 0%;
    background-color: rgb(230, 170, 90);
}

.oa-loading__hint {
    font-size: 14px;
    color: rgb(120, 112, 100);
    margin-top: 8px;
    -unity-text-align: middle-right;
}
