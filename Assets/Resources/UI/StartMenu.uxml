<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="OurAbsenceUI.uss" />
    <ui:VisualElement name="StartMenuRoot" class="oa-root">
        <ui:VisualElement class="oa-backdrop" />
        <ui:VisualElement class="oa-shade" />

        <ui:VisualElement class="oa-title-block">
            <ui:Label text="OUR ABSENCE" class="oa-title" />
            <ui:Label text="Uncover what little light remains, before it is forever consumed." class="oa-subtitle" />
        </ui:VisualElement>

        <ui:VisualElement name="MainPanel" class="oa-menu">
            <ui:Button name="ContinueButton" text="Continue" class="oa-button">
                <ui:Label name="ContinueDetail" class="oa-button__detail" text="" />
            </ui:Button>
            <ui:Button name="NewGameButton" text="New Game" class="oa-button" />
            <ui:Button name="LoadGameButton" text="Load Game" class="oa-button" />
            <ui:Button name="QuitButton" text="Quit" class="oa-button" />
        </ui:VisualElement>

        <ui:Label name="Version" class="oa-version" text="" />

        <ui:VisualElement name="SlotsPanel" class="oa-panel oa-hidden">
            <ui:VisualElement class="oa-panel__frame">
                <ui:Label name="SlotsTitle" class="oa-panel__title" text="Load Game" />
                <ui:VisualElement name="SlotList" />
                <ui:VisualElement class="oa-row">
                    <ui:Button name="BackButton" text="Back" class="oa-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="ConfirmPanel" class="oa-panel oa-hidden">
            <ui:VisualElement class="oa-panel__frame">
                <ui:Label name="ConfirmText" class="oa-confirm__text" text="Are you sure?" />
                <ui:VisualElement class="oa-row">
                    <ui:Button name="ConfirmYes" text="Yes" class="oa-button" />
                    <ui:Button name="ConfirmNo" text="No" class="oa-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
